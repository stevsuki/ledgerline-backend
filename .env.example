# Application
APP_NAME=ledgerline-backend
APP_ENV=development
APP_VERSION=0.1.0

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_REQUEST_TIMEOUT=10s
HTTP_ALLOWED_ORIGINS=*
HTTP_RATE_LIMIT_RPS=20
HTTP_RATE_LIMIT_BURST=40

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ledgerline
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# JWT (MUST be replaced in production, at least 32 random characters)
JWT_SECRET=replace-with-a-random-secret-min-32-chars
JWT_ISSUER=ledgerline
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h
JWT_RESET_TOKEN_TTL=10m


# SMTP (SMTP_ENABLED=false -> emails are printed to the log, not sent)
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=LedgerLine
SMTP_FROM_ADDRESS=no-reply@ledgerline.local
SMTP_TLS=opportunistic
SMTP_TIMEOUT=10s

# OTP for password reset
OTP_LENGTH=6
OTP_TTL=10m
# Log
LOG_LEVEL=info
LOG_FORMAT=json
